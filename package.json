{
    "name": "@bwat47/joplin-plugin-scripts",
    "version": "1.3.0",
    "description": "Shared esbuild build, packaging, version, and API-update scripts for Joplin plugins",
    "license": "MIT",
    "author": "bwat47",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bwat47/joplin-plugin-scripts.git"
    },
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "bin": {
        "joplin-plugin-scripts": "bin/joplin-plugin-scripts.mjs"
    },
    "exports": {
        ".": {
            "types": "./types/index.d.mts",
            "default": "./lib/index.mjs"
        }
    },
    "files": [
        "bin",
        "lib",
        "types"
    ],
    "scripts": {
        "test": "node --test test/*.test.mjs",
        "typecheck": "tsc --project tsconfig.json",
        "build:types": "node -e \"require('node:fs').rmSync('types', { recursive: true, force: true })\" && tsc --project tsconfig.build.json",
        "prepack": "npm run build:types",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm test"
    },
    "dependencies": {
        "esbuild": "^0.28.2",
        "tar": "^7.5.22"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^22.20.5",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-sonarjs": "^4.2.2",
        "globals": "^17.14.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3"
    }
}
