{
    "name": "@bwat47/joplin-plugin-scripts",
    "version": "1.9.0",
    "description": "Shared esbuild build, packaging, version, and API-update scripts for Joplin plugins",
    "license": "MIT",
    "author": "bwat47",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bwat47/joplin-plugin-scripts.git"
    },
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "bin": {
        "joplin-plugin-scripts": "bin/joplin-plugin-scripts.mjs"
    },
    "exports": {
        ".": {
            "types": "./types/index.d.mts",
            "default": "./lib/index.mjs"
        }
    },
    "files": [
        "bin",
        "lib",
        "types"
    ],
    "scripts": {
        "test": "node --test test/*.test.mjs",
        "test:package": "node scripts/smoke-test.mjs",
        "typecheck": "tsc --project tsconfig.json",
        "build:types": "node -e \"require('node:fs').rmSync('types', { recursive: true, force: true })\" && tsc --project tsconfig.build.json",
        "prepack": "npm run build:types",
        "lint": "oxlint && npm run lint:dead-code && npm run lint:complexity",
        "lint:dead-code": "fallow dead-code",
        "lint:complexity": "fallow health --complexity",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm test"
    },
    "dependencies": {
        "esbuild": "^0.28.2",
        "tar": "^7.5.22",
        "tinyglobby": "^0.2.17"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "fallow": "^3.46.0",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "typescript": "^7.0.2"
    }
}
