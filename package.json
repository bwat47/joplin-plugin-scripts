{
    "name": "@bwat47/joplin-plugin-scripts",
    "version": "1.1.0",
    "description": "Shared esbuild build, packaging, version, and API-update scripts for Joplin plugins",
    "license": "MIT",
    "author": "bwat47",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bwat47/joplin-plugin-scripts.git"
    },
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "bin": {
        "joplin-plugin-scripts": "bin/joplin-plugin-scripts.mjs"
    },
    "exports": {
        ".": "./lib/index.mjs"
    },
    "files": [
        "bin",
        "lib"
    ],
    "scripts": {
        "test": "node --test test/*.test.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepublishOnly": "npm run lint && npm run format:check && npm test"
    },
    "dependencies": {
        "esbuild": "^0.28.2",
        "tar": "^7.5.22"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-sonarjs": "^4.2.2",
        "globals": "^17.14.0",
        "prettier": "^3.9.10"
    }
}
