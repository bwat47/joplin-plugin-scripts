{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "module": "NodeNext",
        "target": "ES2022",
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["lib/**/*.mjs", "bin/**/*.mjs", "test/**/*.mjs"]
}
